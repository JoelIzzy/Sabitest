# ---------------------------------------------------------------------------
# Sabitest environment
# Copy to .env.local and fill in. Everything WITHOUT the NEXT_PUBLIC_ prefix is
# server-only and never reaches the browser bundle.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_NAME=Sabitest
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY. Never expose.

# Payment provider: paystack | bachs
PAYMENT_PROVIDER=paystack

# Paystack (https://dashboard.paystack.com/#/settings/developers)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx                   # SERVER ONLY
PAYSTACK_BASE_URL=https://api.paystack.co

# Bachs.io (https://docs.bachs.io)
BACHS_SECRET_KEY=sk_test_xxx                      # SERVER ONLY
BACHS_BASE_URL=https://api.bachs.io

# Virtual numbers provider: herosms | mock
SMS_PROVIDER=mock
HEROSMS_BASE_URL=https://api.herosms.com.ng
HEROSMS_API_KEY=                                  # SERVER ONLY
# How the key is sent: bearer | header | query
HEROSMS_AUTH_SCHEME=bearer
HEROSMS_API_KEY_PARAM=api_key

# SMM provider: rss (Really Simple Social) | mock
SMM_PROVIDER=mock
RSS_API_URL=https://reallysimplesocial.com/api/v2
RSS_API_KEY=                                      # SERVER ONLY

# Default pricing markups in percent (admin can override per service in the DB)
DEFAULT_SMS_MARKUP_PERCENT=25
DEFAULT_SMM_MARKUP_PERCENT=20

# Shared secret for /api/cron/* jobs (send as ?secret= or Authorization: Bearer)
CRON_SECRET=change-me
